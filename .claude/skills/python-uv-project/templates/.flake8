[flake8]
max-line-length = 88
# D400/D401/D415: 英語の文章作法（ピリオド終端・命令形）を前提にしたルールで、
# 日本語のdocstringには馴染まないため無視する（存在チェックのD1xx系は有効なまま）
extend-ignore = E203,D400,D401,D415
extend-exclude = .venv
# テスト関数はdocstring不要（pytestの慣習としてテスト名で内容を表す）
per-file-ignores =
    tests/*: D,DOC
# pydoclint: docstringのArgs/ReturnsセクションをGoogleスタイルとしてパースし、
# 実際の関数シグネチャと突き合わせる（引数名の不一致はDOC103で検出）。
# このプロジェクトのdocstringは型を書かない運用（型は関数シグネチャ側で管理）なので、
# 型注釈まで要求するとDOC105/DOC109/DOC110/DOC203などが誤検知として鳴ってしまう。
# そのため引数・戻り値の型チェックは無効化し、名前の突き合わせだけを有効にする。
style = google
arg-type-hints-in-docstring = False
check-return-types = False
