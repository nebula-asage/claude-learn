{
  // pnpm-projectスキルの構成（ESLint flat config + Prettier format + Vitest）に対応する拡張機能のみを推奨する
  "recommendations": [
    // ESLint本体。eslint.config.js（flat config）を自動検出してエディタ上にlint結果を表示する
    "dbaeumer.vscode-eslint",
    // Prettierフォーマッタ拡張。保存時フォーマット（settings.jsonの[typescript].editor.defaultFormatter）に使用する
    "esbenp.prettier-vscode",
    // Vitestのテストをエディタのテストエクスプローラーから実行・デバッグできるようにする
    "vitest.explorer",
    // @vitest/coverage-v8が出力するカバレッジレポート（coverage/clover.xml等）を読み込み、エディタの行番号横に被覆/未被覆を色付け表示する
    "ryanluker.vscode-coverage-gutters"
  ]
}
