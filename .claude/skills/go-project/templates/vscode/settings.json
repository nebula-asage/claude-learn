{
  // フォーマットはgofmt相当(gopls経由)をgolang.go拡張機能に任せ、保存時に自動フォーマットする
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  // lintはgolangci-lint v2（.golangci.ymlのv2設定を読み込む）に統一する
  // v2系は専用の "golangci-lint-v2" を指定する（"golangci-lint" はv1向けの起動引数になる）
  "go.lintTool": "golangci-lint-v2",
  // 実行ファイルのパスは適用先環境に合わせる（__GOLANGCI_LINT_PATH__ は配置時に置換する。
  // VS Code起動時のPATHにGOPATH/binが含まれない場合でも確実に見つけるため絶対パスで指定する）
  "go.alternateTools": {
    "golangci-lint-v2": "__GOLANGCI_LINT_PATH__"
  },
  "go.lintOnSave": "workspace",
  // カバレッジの可視化（Coverage Gutters拡張）: `just cover-lcov` で
  // coverage.out をgcov2lcovでlcov形式に変換したcoverage.lcovを読み込み、
  // 被覆行を緑、未被覆行を赤でガター（行番号横）に表示する
  // (Coverage GuttersはGoのcoverage.out形式をネイティブ対応していないため変換が必要)
  "coverage-gutters.coverageFileNames": ["coverage.lcov"],
  // gcov2lcovはSF:パスを「最も近いVCSルート（.git等）からの相対パス」で出力する仕様のため、
  // このリポジトリのようにgitルート（モノレポ全体）とVS CodeのworkspaceFolder（プロジェクト自身）が
  // 異なる場合はそのままでは一致しない。差分の "projects/__PROJECT_NAME__/" をここで剥がして解決する
  // (gcov2lcov自体にはVCSルート相対/絶対パスの二択しかなく、この用途の調整オプションはない)
  "coverage-gutters.remotePathResolve": ["projects/__PROJECT_NAME__/", ""],
  "coverage-gutters.showGutterCoverage": true,
  "coverage-gutters.showRulerCoverage": true,
  "coverage-gutters.showLineCoverage": false
}
