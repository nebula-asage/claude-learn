# このjustfileは他言語スキルとの呼び方統一のための薄いラッパーであり、
# タスクの定義自体は持たない（すべて ./gradlew <タスク> を呼ぶだけ）。
# ビルドの実行順序・依存関係はbuild.gradle.kts側が唯一の真実源のまま変わらない。

# 引数なしで実行された場合、レシピの実行順序を表示する
default: usage

# このプロジェクトで最初に何をすべきか、レシピの実行順序を表示する
usage:
    @echo "1. lock       - 初回のみ: 依存関係をgradle.lockfileに固定"
    @echo "2. fmt        - フォーマットを適用"
    @echo "3. check      - 整形チェック・静的解析・テスト・カバレッジ下限・Javadocをまとめて実行"
    @echo "4. run        - アプリケーションを起動"
    @echo ""
    @echo "レシピ一覧は 'just --list' を参照"

# 依存関係をgradle.lockfileに固定する（初回、または依存追加・更新後に実行）
lock:
    ./gradlew dependencies --write-locks

# Spotless + google-java-formatでフォーマットを適用する
fmt:
    ./gradlew spotlessApply

# フォーマット崩れが無いか確認する（適用はしない）
fmt-check:
    ./gradlew spotlessCheck

# Checkstyle（Javadocの有無）とSpotBugs（バグ検出）で静的解析する
lint:
    ./gradlew checkstyleMain checkstyleTest spotbugsMain spotbugsTest

# JUnitでテストを実行する
test:
    ./gradlew test

# カバレッジレポートを生成し、行カバレッジ80%の下限を検証する
cover:
    ./gradlew jacocoTestReport jacocoTestCoverageVerification

# javadocのdoclintでドキュメンテーションコメントの中身を検証し、APIリファレンスを生成する
doc:
    ./gradlew javadoc

# 整形チェック・静的解析・テスト・カバレッジ下限・Javadocを一括実行する
check:
    ./gradlew check

# アプリケーションを起動する
run:
    ./gradlew bootRun

# ビルド成果物を削除する
clean:
    ./gradlew clean
