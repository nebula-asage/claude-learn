{
  // ディレクトリ単位の.markdownlint.jsoncはリポジトリルートの設定を自動マージせず
  // 丸ごと置き換えるため、"extends"でルートの設定（MD013の無効化を含む）を明示的に継承する
  "extends": "../../.markdownlint.jsonc",
  // この配下（.claude/agents/**）のファイルはサブエージェント向けのプロンプト定義で、
  // frontmatterに続けて「あなたは...である。」から始まる文章というこのリポジトリで
  // 一貫した構成になっている。人間向け文書としてのH1見出しは意図的に置いていないため、
  // ここだけMD041（先頭行は見出しであるべき）を無効化する
  "MD041": false
}
