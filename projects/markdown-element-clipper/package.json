{
  "name": "markdown-element-clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "node scripts/build.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none --treatValidationWarningsAsErrors",
    "prepare": "node scripts/install-husky.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1",
    "turndown": "^7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5",
    "@vitest/coverage-v8": "^4",
    "esbuild": "^0.28",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-jsdoc": "^63",
    "husky": "^9",
    "jsdom": "^30",
    "lint-staged": "^17",
    "prettier": "^3",
    "typedoc": "^0.28",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}
