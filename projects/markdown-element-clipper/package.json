{
  "name": "markdown-element-clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "pretest:e2e": "node scripts/build.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1",
    "turndown": "^7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5",
    "esbuild": "^0.28",
    "jsdom": "^30",
    "typescript": "^5",
    "vitest": "^4"
  }
}
