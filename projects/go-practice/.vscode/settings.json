{
  // 保存時にファイル末尾に改行を1行だけ入れる（改行なし/複数改行の食い違いを防ぐ）
  "files.insertFinalNewline": true,
  // 保存時に行末の余分な空白を自動的に削除する
  "files.trimTrailingWhitespace": true,
  // 改行コードをLFに統一する（Windows由来のCRLF混入を防ぐ）
  "files.eol": "\n",
  // ファイルの文字エンコーディングを内容から自動推測する
  "files.autoGuessEncoding": true,
  // インデント幅・タブ/スペースをファイルの内容から自動検出する
  "editor.detectIndentation": true,
  // 桁の目安となる縦線を表示する（80桁・120桁）
  "editor.rulers": [80, 120],
  // 選択範囲に関わらず、空白文字を常に可視化する
  "editor.renderWhitespace": "all",
  // 差分表示で行頭・行末の空白の違いも差分として表示する
  "diffEditor.ignoreTrimWhitespace": false,
  // ソース管理ビューでファイルをツリー表示にする
  "scm.defaultViewMode": "tree",
  // VS Code組み込みのAI機能（インライン提案・チャット等）を無効化する
  "chat.disableAIFeatures": true,
  // cspell.jsonの$schemaが参照するJSONスキーマのダウンロード可否を毎回確認されないよう、配布元ドメインを信頼済みにする
  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json": true
  },
  // Code Spell Checker拡張機能が読み込む設定ファイルを明示する（配置先直下のcspell.jsonを自動検出に頼らず固定する）
  "cSpell.files": ["${workspaceFolder}/cspell.json"],
  // JSON/JSONC（コメント付きJSON）はVS Code組み込みフォーマッタで完結するため、保存時に自動整形する
  "[json]": {
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.formatOnSave": true
  },
  // フォーマットはgofmt相当(gopls経由)をgolang.go拡張機能に任せ、保存時に自動フォーマットする
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  // lintはgolangci-lint（.golangci.ymlのv2設定を読み込む）に統一する
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  // カバレッジの可視化（Coverage Gutters拡張）: `just cover-lcov` で
  // coverage.out をgcov2lcovでlcov形式に変換したcoverage.lcovを読み込み、
  // 被覆行を緑、未被覆行を赤でガター（行番号横）に表示する
  // (Coverage GuttersはGoのcoverage.out形式をネイティブ対応していないため変換が必要)
  "coverage-gutters.coverageFileNames": ["coverage.lcov"],
  // gcov2lcovはSF:パスを「最も近いVCSルート（.git等）からの相対パス」で出力する仕様のため、
  // このリポジトリのようにgitルート（/workspace-root）とVS CodeのworkspaceFolder（このディレクトリ自身）が
  // 異なる場合はそのままでは一致しない。差分の "projects/go-practice/" をここで剥がして解決する
  // (gcov2lcov自体にはVCSルート相対/絶対パスの二択しかなく、この用途の調整オプションはない)
  "coverage-gutters.remotePathResolve": ["projects/go-practice/", ""],
  "coverage-gutters.showGutterCoverage": true,
  "coverage-gutters.showRulerCoverage": true,
  "coverage-gutters.showLineCoverage": false
}
