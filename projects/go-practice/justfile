# 引数なしで実行された場合、レシピの実行順序を表示する
default: usage

# このプロジェクトで最初に何をすべきか、レシピの実行順序を表示する
usage:
    @echo "1. fmt        - フォーマットを適用"
    @echo "2. lint        - 静的解析"
    @echo "3. test        - テスト実行"
    @echo "4. cover       - カバレッジ計測（HTMLは cover-html、Coverage Gutters向けは cover-lcov）"
    @echo "5. doc         - ドキュメンテーションコメントをターミナルに表示（ファイル生成は doc-report、HTMLは doc-html）"
    @echo "6. build       - バイナリ go-practice を生成"
    @echo "7. run         - アプリケーションを実行"
    @echo ""
    @echo "レシピ一覧は 'just --list' を参照"

# gofmtでフォーマットを適用する
fmt:
    gofmt -l -w .

# golangci-lintで静的解析する
lint:
    golangci-lint run ./...

# go testで単体テストを実行する
test:
    go test ./... -v

# go:generateディレクティブに従ってモック等の生成コードを再生成する
generate:
    go generate ./...

# カバレッジを計測し、関数ごとの被覆率をターミナルに表示する
cover:
    go test ./... -coverprofile=coverage.out
    go tool cover -func=coverage.out

# カバレッジを計測し、coverage.html にHTMLレポートを生成する
cover-html: cover
    go tool cover -html=coverage.out -o coverage.html

# カバレッジを計測し、coverage.lcov（Coverage Gutters拡張向け）を生成する
cover-lcov: cover
    gcov2lcov -infile=coverage.out -outfile=coverage.lcov

# ドキュメンテーションコメントからMarkdown形式のAPIドキュメントをターミナルに出力する
doc:
    gomarkdoc ./...

# 各パッケージディレクトリにAPI.mdとしてAPIドキュメントを生成する
doc-report:
    # gomarkdoc自身の出力テンプレート構文はjustの変数展開と衝突するため、
    # 波括弧を文字列リテラルとして組み立てることでリテラルの中括弧をgomarkdocに渡している
    gomarkdoc --output '{{"{{"}}.Dir{{"}}"}}/API.md' ./...

# ドキュメンテーションコメントからHTML形式のAPIドキュメント api.html を生成する（gomarkdocのMarkdown出力をpnpxでmarkedに変換。断片のため文字コード宣言を前置する）
doc-html:
    { echo '<meta charset="utf-8">'; gomarkdoc ./... | pnpx marked --gfm; } > api.html

# go buildでバイナリ go-practice を生成する
build:
    go build -o go-practice .

# go runでアプリケーションを実行する
run:
    go run .

# カバレッジ・ドキュメント・ビルド生成物を削除する
clean:
    rm -f coverage.out coverage.html coverage.lcov api.html go-practice
    find . -name API.md -delete

# pnpxでcspellを取得し、スペルチェックを実行する（未知語が出た場合はcspell.jsonのwordsに追記して解消する）
cspell:
    pnpx cspell --no-progress .

# pnpxでmarkdownlint-cli2を取得し、Markdownの構文・スタイルをlintする
markdownlint:
    pnpx markdownlint-cli2 "**/*.md"
