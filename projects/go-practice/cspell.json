{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  // このモノレポはコメント・ドキュメントが日本語主体。英語辞書をベースにしつつ、
  // 日本語部分はignoreRegExpListで検査対象から外し、コード識別子や英語コメントだけを検査する
  "language": "en",
  "ignorePaths": [
    "node_modules/**", // Node.js依存パッケージ本体
    "dist/**", // ビルド生成物（tsc等）
    "build/**", // ビルド生成物（Gradle等）
    "target/**", // ビルド生成物（Cargo/Rust）
    "coverage/**", // カバレッジレポート生成物（vitest/pytest-cov等）
    "htmlcov/**", // カバレッジHTMLレポート生成物（pytest-cov）
    "docs/api/**", // APIドキュメント生成物（TypeDoc/pdoc/gomarkdoc/rustdoc/javadoc等）
    ".venv/**", // Python仮想環境（uv）
    "__pycache__/**", // Pythonのバイトコードキャッシュ
    ".pytest_cache/**", // pytestのキャッシュ
    ".mypy_cache/**", // mypyのキャッシュ
    ".ruff_cache/**", // ruffのキャッシュ
    ".gradle/**", // Gradleのキャッシュ・生成物
    "pnpm-lock.yaml", // pnpmのロックファイル
    "package-lock.json", // npmのロックファイル
    "yarn.lock", // yarnのロックファイル
    "uv.lock", // uvのロックファイル
    "poetry.lock", // poetryのロックファイル
    "Cargo.lock", // cargoのロックファイル
    "go.sum", // goモジュールのチェックサムファイル
    "gradle.lockfile", // Gradleの依存ロックファイル
    "*.log", // 実行時ログ
    ".devcontainer/**" // devcontainer構成ファイル（Dockerfile内のパッケージ名等で未知語が多いため除外）
  ],
  // ひらがな・カタカナ・漢字（CJK統合漢字）・半角カタカナの並びは検査対象から除外する。
  // これにより日本語部分は素通りし、コード中の識別子や英語のコメント部分だけを検査できる
  "ignoreRegExpList": ["/[\\u3040-\\u30ff\\u3400-\\u4dbf\\u4e00-\\u9fff\\uf900-\\ufaff\\uff66-\\uff9f]+/gu"],
  // 以下はこのcspell.json自身の`ignorePaths`コメント（ツール名・ディレクトリ名の断片）に
  // 由来する未知語で、テンプレートをそのまま配置するとどのプロジェクトでも必ず検出されるため
  // あらかじめ登録してある。プロジェクト固有の用語・識別子・略語はこれらの下に追加していく。
  // 配置先で実際に `npx cspell --no-progress .` を実行して検出された未知語のうち、
  // 誤字ではなく正当な語だけを1件ずつ追記する（由来がわかるようインラインコメントを添える）
  "words": [
    "gomarkdoc", // ignorePathsのコメント: GoのAPIドキュメント生成ツール名
    "htmlcov", // ignorePathsのパス・コメント: pytest-covが生成するカバレッジHTMLディレクトリ名
    "mypy", // ignorePathsのパス・コメント: Pythonの型チェッカー名（.mypy_cache）
    "pdoc", // ignorePathsのコメント: PythonのAPIドキュメント生成ツール名
    "pycache", // ignorePathsのパス: Pythonのバイトコードキャッシュディレクトリ名（__pycache__）
    "pytest", // ignorePathsのコメント: Pythonのテストツール名
    "rustdoc", // ignorePathsのコメント: RustのAPIドキュメント生成ツール名
    "venv", // ignorePathsのパス: Python仮想環境ディレクトリ名（.venv）
    "coverprofile", // justfile: `go test -coverprofile`のフラグ名
    "gcov", // justfile: gcov2lcov（ツール名の一部）
    "infile", // justfile: `gcov2lcov -infile`のフラグ名
    "gofmt", // Go標準のフォーマッタコマンド名
    "golangci", // golangci-lint（静的解析ツール）の名称の一部
    "princjef", // README.md: gomarkdocの作者のGitHubユーザー名
    "pnpx", // justfile: pnpmが提供するnpx相当のパッケージ実行コマンド（cspellレシピで使用）
    "testuser", // internal/*/テストコード: テスト用ユーザー名の固定値
    "newuser", // internal/command/user_command_test.go: 更新後のテスト用ユーザー名の固定値
    "gomock", // go.uber.org/mock（gomock）: モックライブラリ名
    "mockgen", // go.uber.org/mockのモック生成ツール名
    "isgomock", // mockgenが生成するモックの構造体フィールド名
    "gobco", // justfile・go.mod・AGENTS.md: Goの条件カバレッジ計測ツール名
    "rillig", // go.mod: gobcoの作者のGitHubユーザー名（モジュールパスの一部）
    "govulncheck", // justfile・go.mod・README.md: Goの脆弱性検査ツール名
    "pipefail", // justfile: bashの `set -o pipefail` オプション名
    "unwritable", // internal/repository/json_user_repository_test.go: 書き込み不可の状態を指すテスト内の語
    "godoc", // TODO.md: Goのドキュメントツール名
    "GOARCH", // TODO.md: Goの環境変数名（ビルド対象アーキテクチャ）
    "goimports", // AGENTS.md・justfile・README.md・go.mod: import整理ツール名
    // 以下はgo.modの間接依存のモジュールパス（GitHubユーザー名・リポジトリ名・ドメインパス）の一部
    "jandelgado", // go.mod: gcov2lcovの作者のGitHubユーザー名
    "winio", // go.mod: Microsoft/go-winio
    "ewma", // go.mod: VividCortex/ewma
    "cheggaaa", // go.mod: cheggaaa/pb
    "emirpasic", // go.mod: emirpasic/gods
    "fatih", // go.mod: fatih/color
    "fsnotify", // go.mod: fsnotify/fsnotify
    "gcfg", // go.mod: gopkg.in/gcfg
    "imdario", // go.mod: imdario/mergo
    "mergo", // go.mod: imdario/mergo
    "inconshreveable", // go.mod: inconshreveable/mousetrap
    "jbenet", // go.mod: jbenet/go-context
    "kevinburke", // go.mod: kevinburke/ssh_config
    "logrusorgru", // go.mod: logrusorgru/aurora
    "magiconair", // go.mod: magiconair/properties
    "mattn", // go.mod: mattn/go-isatty・go-runewidth等
    "isatty", // go.mod: mattn/go-isatty
    "runewidth", // go.mod: mattn/go-runewidth
    "mgutz", // go.mod: mgutz/ansi
    "mitchellh", // go.mod: mitchellh/go-homedir・mapstructure
    "mapstructure", // go.mod: mitchellh/mapstructure
    "mageutil", // go.mod: モジュールパスの一部
    "termdiff", // go.mod: モジュールパスの一部
    "rivo", // go.mod: rivo/uniseg
    "uniseg", // go.mod: rivo/uniseg
    "russross", // go.mod: russross/blackfriday
    "blackfriday", // go.mod: russross/blackfriday
    "sergi", // go.mod: sergi/go-diff
    "sirupsen", // go.mod: sirupsen/logrus
    "logrus", // go.mod: sirupsen/logrus
    "afero", // go.mod: spf13/afero
    "jwalterweatherman", // go.mod: spf13/jwalterweatherman
    "pflag", // go.mod: spf13/pflag
    "subosito", // go.mod: subosito/gotenv
    "gotenv", // go.mod: subosito/gotenv
    "xanzy", // go.mod: xanzy/ssh-agent
    "gopkg", // go.mod: gopkg.in/...
    "mvdan", // go.mod: mvdan.cc/xurls
    "xurls" // go.mod: mvdan.cc/xurls
  ]
}
