# 引数なしで実行された場合、レシピの実行順序を表示する
default: usage

# このプロジェクトで最初に何をすべきか、レシピの実行順序を表示する
usage:
    @echo "1. install           - 初回: 依存関係をインストール"
    @echo "2. prepare           - 初回: Git hooksを有効化"
    @echo "3. fmt / lint / typecheck - 日常的な整形・静的解析・型チェック"
    @echo "4. test / cover      - テストとカバレッジ計測"
    @echo "5. dev / build / preview - 開発サーバー起動、ビルド、ビルド結果の確認"
    @echo "6. doc               - APIドキュメントを生成"
    @echo ""
    @echo "レシピ一覧は 'just --list' を参照"

# 依存関係をインストールする
install:
    pnpm install

# Git hooksを有効化する（pnpm installではignoreScriptsによりprepareが自動実行されないため初回のみ手動実行）
prepare:
    pnpm run prepare

# Viteの開発サーバを起動する
dev:
    pnpm run dev

# dist/に本番ビルドを出力する
build:
    pnpm run build

# ビルド結果をローカルで配信して確認する
preview:
    pnpm run preview

# 画面のプレビュー画像をdist-tools/に生成する（タイトル・都市・各種オーバーレイ等）
preview-png:
    pnpm run preview:png

# TypeScriptの型チェックを行う（本体・テストの両方）
typecheck:
    pnpm run typecheck

# ESLintで静的解析する（JSDoc必須チェックを含む）
lint:
    pnpm run lint

# ESLintの自動修正を適用する
lint-fix:
    pnpm run lint:fix

# Prettierでフォーマットを適用する
fmt:
    pnpm run format

# フォーマット崩れが無いか確認する（適用はしない）
fmt-check:
    pnpm run format:check

# Vitestでシミュレーションのユニットテストを実行する
test:
    pnpm test

# Vitestを監視モードで実行する
test-watch:
    pnpm run test:watch

# カバレッジを計測し、coverage/にHTMLレポートを生成する
cover:
    pnpm run test:coverage

# TypeDocでdocs/api/にAPIリファレンスを生成する
doc:
    pnpm run docs

# HTMLを出さず、JSDoc記述漏れだけを検証する
doc-check:
    pnpm run docs:check

# pnpxでcspellを取得し、スペルチェックを実行する（未知語が出た場合はcspell.jsonのwordsに追記して解消する）
cspell:
    pnpx cspell --no-progress .

# pnpxでmarkdownlint-cli2を取得し、Markdownの構文・スタイルをlintする
markdownlint:
    pnpx markdownlint-cli2 "**/*.md"

# ビルド・カバレッジ・ドキュメント生成物を削除する
clean:
    rm -rf dist dist-tools coverage docs/api
