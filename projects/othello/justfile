# 引数なしで実行された場合、レシピの実行順序を表示する
default: usage

# このプロジェクトで最初に何をすべきか、レシピの実行順序を表示する
usage:
    @echo "1. install           - 初回: 依存関係をインストール"
    @echo "2. prepare           - 初回: Git hooksを有効化"
    @echo "3. fmt / lint / typecheck - 日常的な整形・静的解析・型チェック"
    @echo "4. test / cover      - テストとカバレッジ計測"
    @echo "5. dev / tauri-dev   - ブラウザ、またはデスクトップアプリとして動作確認"
    @echo "6. build / tauri-build - フロントエンド、またはデスクトップアプリをビルド"
    @echo "7. doc               - APIドキュメントを生成"
    @echo ""
    @echo "レシピ一覧は 'just --list' を参照"

# 依存関係をインストールする
install:
    pnpm install

# Git hooksを有効化する（pnpm installではignoreScriptsによりprepareが自動実行されないため初回のみ手動実行）
prepare:
    pnpm run prepare

# ブラウザで動かす（Viteの開発サーバーのみ）
dev:
    pnpm dev

# デスクトップアプリとして起動する（Tauri）
tauri-dev:
    pnpm exec tauri dev

# デスクトップアプリをビルドする（実行ファイル/インストーラーを生成）
tauri-build:
    pnpm exec tauri build

# Viteでフロントエンドをビルドする（dist/）
build:
    pnpm run build

# ビルド済みのフロントエンドをプレビューする
preview:
    pnpm run preview

# TypeScriptの型チェックのみ実行する
typecheck:
    pnpm run typecheck

# ESLintで静的解析する
lint:
    pnpm run lint

# ESLintの自動修正を適用する
lint-fix:
    pnpm run lint:fix

# Prettierでフォーマットを適用する
fmt:
    pnpm run format

# フォーマット崩れが無いか確認する（適用はしない）
fmt-check:
    pnpm run format:check

# Vitestでテストを実行する（src/othello.tsが対象）
test:
    pnpm test

# Vitestを監視モードで実行する
test-watch:
    pnpm run test:watch

# カバレッジを計測し、coverage/にHTMLレポートを生成する
cover:
    pnpm run test:coverage

# TypeDocでdocs/api/にAPIリファレンスを生成する（対象はsrc/othello.ts）
doc:
    pnpm run docs

# HTMLを出さず、JSDoc記述漏れだけを検証する
doc-check:
    pnpm run docs:check

# pnpxでcspellを取得し、スペルチェックを実行する（未知語が出た場合はcspell.jsonのwordsに追記して解消する）
cspell:
    pnpx cspell --no-progress .

# pnpxでmarkdownlint-cli2を取得し、Markdownの構文・スタイルをlintする
markdownlint:
    pnpx markdownlint-cli2 "**/*.md"

# ビルド・カバレッジ・ドキュメント生成物を削除する（Tauriのビルド成果物含む）
clean:
    rm -rf dist dist-ssr coverage docs/api src-tauri/target
