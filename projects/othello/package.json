{
  "name": "othello",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none --treatValidationWarningsAsErrors",
    "prepare": "node scripts/install-husky.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-plugin-jsdoc": "^63",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "husky": "^9",
    "lint-staged": "^17",
    "prettier": "^3",
    "typedoc": "^0.28",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8.2.0",
    "vitest": "^4"
  }
}
