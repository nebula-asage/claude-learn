{
  // 保存時にファイル末尾に改行を1行だけ入れる（改行なし/複数改行の食い違いを防ぐ）
  "files.insertFinalNewline": true,
  // 保存時に行末の余分な空白を自動的に削除する
  "files.trimTrailingWhitespace": true,
  // 改行コードをLFに統一する（Windows由来のCRLF混入を防ぐ）
  "files.eol": "\n",
  // ファイルの文字エンコーディングを内容から自動推測する
  "files.autoGuessEncoding": true,
  // インデント幅・タブ/スペースをファイルの内容から自動検出する
  "editor.detectIndentation": true,
  // 桁の目安となる縦線を表示する（80桁・120桁）
  "editor.rulers": [80, 120],
  // 選択範囲に関わらず、空白文字を常に可視化する
  "editor.renderWhitespace": "all",
  // 差分表示で行頭・行末の空白の違いも差分として表示する
  "diffEditor.ignoreTrimWhitespace": false,
  // ソース管理ビューでファイルをツリー表示にする
  "scm.defaultViewMode": "tree",
  // VS Code組み込みのAI機能（インライン提案・チャット等）を無効化する
  "chat.disableAIFeatures": true,
  // cspell.jsonの$schemaが参照するJSONスキーマのダウンロード可否を毎回確認されないよう、配布元ドメインを信頼済みにする
  "json.schemaDownload.trustedDomains": [
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json"
  ],
  // JSON/JSONC（コメント付きJSON）はVS Code組み込みフォーマッタで完結するため、保存時に自動整形する
  "[json]": {
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.formatOnSave": true
  },
  // ESLint(flat config: eslint.config.js)は拡張機能側が自動検出するため追加設定は不要
  // フォーマットはPrettierに統一し、保存時に自動フォーマットする
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  // カバレッジの可視化（Coverage Gutters拡張）: `pnpm run test:coverage` を実行すると
  // @vitest/coverage-v8のデフォルトレポータ(clover/json)が生成する coverage/clover.xml・
  // coverage/coverage-final.json を読み込み、被覆行を緑、未被覆行を赤でガター（行番号横）に表示する
  "coverage-gutters.coverageFileNames": ["clover.xml", "coverage-final.json"],
  "coverage-gutters.showGutterCoverage": true,
  "coverage-gutters.showRulerCoverage": true,
  "coverage-gutters.showLineCoverage": true,
  "coverage-gutters.watchOnActivate": true,
  // TypeScript IntelliSenseにVS Code組み込み版ではなくワークスペースの node_modules/typescript を使わせる
  // （設定しても初回はセキュリティ確認のダイアログで「Allow」を1回クリックする必要がある）
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true
}
