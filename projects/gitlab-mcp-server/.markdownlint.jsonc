{
  // markdownlintの既定ルールセットをベースにする。個別の緩和は、配置先で実際にlintを実行して
  // 検出された結果を見てから追記する（cspell.jsonのwordsと同じく、実データを見ずに先回りで緩めない）
  "default": true,
  // このモノレポは長文の日本語散文を80桁等で折り返さず1文1行で書く方針のため、
  // 行長制限は文章の誤りではなく書き方の方針差でしかない。無効化する
  "MD013": false,
  // MD050（強調記号**/__の統一）の--fixは、__PROJECT_NAME__のようなテンプレートの
  // プレースホルダ（二重アンダースコア）を強調記法と誤認識し、ファイル内の他の**強調**を
  // 巻き込んで__に書き換えてしまう実害が確認された。無効化する
  "MD050": false,
  // MD034（裸のURLを<>で囲む）の--fixは、全角の閉じ括弧など直後に区切り文字が無いURLで
  // 終端位置を誤り、離れた場所の無関係なコード片に`>`を混入させる破損が実際に発生した。
  // 自動修正を信用できないため無効化する（裸のURL自体は実害のないスタイルの好みに留まる）
  "MD034": false
}
