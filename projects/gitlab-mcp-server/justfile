# 引数なしで実行された場合、レシピの実行順序を表示する
default: usage

# このプロジェクトで最初に何をすべきか、レシピの実行順序を表示する
usage:
    @echo "1. install    - 初回: 依存関係をインストール"
    @echo "2. prepare    - 初回: Git hooksを有効化"
    @echo "3. fmt / lint / typecheck - 日常的な整形・静的解析・型チェック"
    @echo "4. test / cover - ユニットテストとカバレッジ計測（E2Eは test-e2e。事前にtest-env/の起動が必要）"
    @echo "5. build / start - ビルドして実行（devはwatchモード）"
    @echo "6. doc        - APIドキュメントを生成"
    @echo ""
    @echo "レシピ一覧は 'just --list' を参照"

# 依存関係をインストールする
install:
    pnpm install

# tscでdist/にビルドする
build:
    pnpm run build

# dist/index.jsを実行する（先にbuildが必要）
start:
    pnpm start

# ビルドをwatchモードで追従させる
dev:
    pnpm run dev

# 型チェックのみ実行する（src/testの両方が対象。ビルド成果物は出力しない）
typecheck:
    pnpm run typecheck

# ESLintで静的解析する
lint:
    pnpm run lint

# ESLintの自動修正を適用する
lint-fix:
    pnpm run lint:fix

# Prettierでフォーマットを適用する
fmt:
    pnpm run format

# フォーマット崩れが無いか確認する（適用はしない）
fmt-check:
    pnpm run format:check

# cspellでスペルチェックする
spellcheck:
    pnpm run spellcheck

# vitestでテストを実行する
test:
    pnpm test

# vitestを監視モードで実行する
test-watch:
    pnpm run test:watch

# ビルド後、E2Eテストを実行する
test-e2e:
    pnpm run test:e2e

# カバレッジを計測し、coverage/にHTML・clover.xml・coverage-final.jsonを生成する
cover:
    pnpm run test:coverage

# TypeDocでdocs/api/にAPIドキュメントを生成する
doc:
    pnpm run docs

# HTMLを出さず、JSDoc記述漏れだけを検証する
doc-check:
    pnpm run docs:check

# Git hooksを有効化する（pnpm installではignoreScriptsによりprepareが自動実行されないため初回のみ手動実行）
prepare:
    pnpm run prepare

# pnpxでmarkdownlint-cli2を取得し、Markdownの構文・スタイルをlintする
markdownlint:
    pnpx markdownlint-cli2 "**/*.md"

# ビルド・カバレッジ・ドキュメント生成物を削除する
clean:
    rm -rf dist coverage docs
