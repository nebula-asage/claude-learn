# GitLab接続設定（必須）
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# 省略時にツール引数の project を補う既定プロジェクト（任意）
# GITLAB_DEFAULT_PROJECT=group/repo

# trueにすると作成・更新系ツールを一切登録しない（任意、既定はfalse）
# GITLAB_READ_ONLY=false

# GitLab APIリクエストのタイムアウト（ミリ秒、任意、既定30000）
# GITLAB_TIMEOUT_MS=30000

# トランスポート: stdio | http（任意、既定stdio）
MCP_TRANSPORT=http

# --- 以下はMCP_TRANSPORT=http のときのみ意味を持つ ---

# コンテナ内でのバインドアドレス。docker-compose.yml から使う場合は0.0.0.0のままでよい
# （外部への公開範囲はホスト側のポートバインド設定で制御する）
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000

# 設定すると Authorization: Bearer <token> を必須にする（任意だが公開環境では強く推奨）
# MCP_HTTP_AUTH_TOKEN=change-me

# カンマ区切りの許可Origin一覧。未設定の場合、Originヘッダ付きリクエスト（ブラウザ経由）は拒否される
# MCP_HTTP_ALLOWED_ORIGINS=http://localhost:3000
